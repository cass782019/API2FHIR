# ─────────────────────────────────────────────────────────────
# FHIR-Forge — variáveis de ambiente
# Copiar para .env e ajustar. NUNCA commitar .env.
# ─────────────────────────────────────────────────────────────

# ─── Postgres ─────────────────────────────────────────────────
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge_dev_change_me
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── Minio (S3-compatible) ────────────────────────────────────
MINIO_ROOT_USER=forge
MINIO_ROOT_PASSWORD=forge_dev_change_me_min8chars
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_ARTIFACTS=forge-artifacts
MINIO_BUCKET_CODESYSTEMS=forge-codesystems

# ─── HAPI FHIR ────────────────────────────────────────────────
HAPI_PORT=8090
HAPI_BASE_URL=http://localhost:8090/fhir

# ─── Snowstorm ────────────────────────────────────────────────
SNOWSTORM_PORT=8080
ES_PORT=9200

# ─── Langfuse ─────────────────────────────────────────────────
LANGFUSE_PORT=3000
# Gerar com: openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=
# Gerar com: openssl rand -base64 32
LANGFUSE_SALT=
# Gerar com: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=

# ─── Adminer (debug profile) ─────────────────────────────────
ADMINER_PORT=8081

# ─── LLM providers ───────────────────────────────────────────
# Anthropic (cloud)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRIMARY=claude-opus-4-7
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# AWS Bedrock (alternative cloud)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_PRIMARY=anthropic.claude-sonnet-4-6-v1:0

# OpenAI (fallback)
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-4.1

# Maritaca (LLM PT-BR)
MARITACA_API_KEY=
MARITACA_MODEL=sabia-4

# vLLM on-prem (LGPD estrita)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=local-dev
VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ─── Roteamento LLM ───────────────────────────────────────────
# Política em config/llm_routing.yaml; este flag vira default global.
LLM_DEFAULT_ROUTE=anthropic
LLM_PHI_ROUTE=vllm-onprem

# ─── Observabilidade ─────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=fhir-forge
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─── RNDS (homologação) ──────────────────────────────────────
RNDS_BASE_URL=https://ehr-services.hmg.saude.gov.br
RNDS_AUTH_URL=https://ehr-auth.hmg.saude.gov.br/api/token
RNDS_CERT_PATH=./secrets/rnds-hml.pfx
RNDS_CERT_PASSWORD=
RNDS_CNES=
RNDS_CNPJ_AUTORIZADOR=
RNDS_REQUESTING_PROFESSIONAL_CPF=

# ─── ProxyLLM (proxy local — use quando não tem API key) ────────
# Suba com: make proxy   ou   make proxy-docker
# Depois configure:
PROXYLLM_PORT=9099
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Para apontar o pipeline para o proxy:
# ANTHROPIC_BASE_URL=http://localhost:9099
# ANTHROPIC_API_KEY=proxyllm-local

# ─── Application ─────────────────────────────────────────────
ENV=development
LOG_LEVEL=DEBUG
LOG_FORMAT=json
API_HOST=0.0.0.0
API_PORT=8000
WORKER_CONCURRENCY=4

# ─── Feature flags ───────────────────────────────────────────
# Permite que módulos enviem PHI a LLMs cloud (NUNCA true em produção sem DPA)
FEATURE_ALLOW_PHI_EGRESS=false
# Habilita endpoints administrativos sem autenticação (apenas dev)
FEATURE_ADMIN_NOAUTH=true
# Liga MCP server no /mcp do FastAPI gateway
FEATURE_MCP_ENABLED=true
